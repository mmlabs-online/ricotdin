#!/bin/sh
# Sourced by the nginx entrypoint before the templates are rendered (ARC-11).
# The values end up in nginx config and in JSON, so only a plain origin is accepted.
origin_ok() {
  # Character allow-list first: grep matches per line, so a value with a newline could pass it.
  case "$1" in *[!A-Za-z0-9.:/-]*) return 1 ;; esac
  printf '%s' "$1" | grep -Eq '^(https://[A-Za-z0-9.-]+(:[0-9]{1,5})?|http://(localhost|127\.0\.0\.1)(:[0-9]{1,5})?)$'
}
if [ -z "${RICOTDIN_API_URL:-}" ] || ! origin_ok "$RICOTDIN_API_URL"; then
  echo "ricotdin-web: RICOTDIN_API_URL must be an https origin like https://api.example.com" >&2
  exit 1
fi
: "${RICOTDIN_AUTH_URL:=$RICOTDIN_API_URL}"
if ! origin_ok "$RICOTDIN_AUTH_URL"; then
  echo "ricotdin-web: RICOTDIN_AUTH_URL must be an https origin" >&2
  exit 1
fi
export RICOTDIN_API_URL RICOTDIN_AUTH_URL
