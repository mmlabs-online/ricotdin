# Included in every location: add_header in a location replaces the server-level ones.
add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data: blob: ${RICOTDIN_API_URL}; media-src 'self' blob: ${RICOTDIN_API_URL}; font-src 'self'; connect-src 'self' ${RICOTDIN_API_URL} ${RICOTDIN_AUTH_URL} https://www.googleapis.com; manifest-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'" always;
add_header X-Content-Type-Options "nosniff" always;
add_header Referrer-Policy "no-referrer" always;
add_header X-Frame-Options "DENY" always;
add_header Cross-Origin-Opener-Policy "same-origin" always;
add_header Permissions-Policy "camera=(), geolocation=(), payment=(), usb=(), microphone=(self), display-capture=(self)" always;
add_header Strict-Transport-Security "max-age=31536000" always;
